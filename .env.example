# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection used by the app and by drizzle-kit.
DATABASE_URL=""

# Separate database used by the integration test suite. Tests truncate tables,
# so this must never point at the development database.
TEST_DATABASE_URL=""

# Secret used by better-auth to sign session tokens. Must be at least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""

# Public base URL better-auth resolves its routes against.
BETTER_AUTH_URL=""

# HTTP port for the Express server.
PORT=""

# Comma-separated origins allowed to call the API from a browser. Empty means
# no cross-origin request is allowed. For a local frontend (3000, or 5173 for Vite), uncomment:
# TRUSTED_ORIGINS="http://localhost:3000,http://localhost:5173"
TRUSTED_ORIGINS=""

# Set to false to stop serving the API reference at /api/docs.
DOCS_ENABLED="true"

# Comma-separated domains allowed to register. Sign-up with any other domain is
# rejected with 403 EMAIL_DOMAIN_NOT_ALLOWED. Only change this for a deployment
# that is not AmaliTech's.
ALLOWED_EMAIL_DOMAINS="amalitech.com,amalitechtraining.org"

# S3 bucket that stores user avatars, and its region. Locally the AWS SDK needs
# credentials too (AWS_PROFILE or AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY); on EC2
# it uses the instance role.
AWS_REGION="eu-west-1"
S3_BUCKET="ride-connect-avatars-dev-004165097941-eu-west-1-an"

# Optional public base URL for stored images. Defaults to the bucket's S3 URL.
# MEDIA_BASE_URL=""
