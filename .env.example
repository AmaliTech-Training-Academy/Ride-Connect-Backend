# Port the HTTP server listens on
PORT=3000

# PostgreSQL connection string (AWS RDS/Aurora/self-managed EC2 — provisioned separately).
# Shared by both Drizzle and Better Auth.
DATABASE_URL=postgres://user:password@localhost:5432/ride_connect

# Whether the Postgres client requires an SSL connection. Most AWS-hosted Postgres
# requires SSL; set to "false" for a local Postgres instance without SSL.
DATABASE_SSL=true

# Secret used by Better Auth to sign sessions/cookies — generate a long random value.
BETTER_AUTH_SECRET=

# Base URL of this API, used by Better Auth for cookies and redirects.
BETTER_AUTH_URL=http://localhost:3000
