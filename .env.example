# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection used by the app and by drizzle-kit.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/rideconnect_dev

# Separate database used by the integration test suite. Tests truncate tables,
# so this must never point at the development database.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/rideconnect_test

# Secret used by better-auth to sign session tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace-with-a-random-32-byte-base64-secret

# Public base URL better-auth resolves its routes against.
BETTER_AUTH_URL=http://localhost:3000

# HTTP port for the Express server.
PORT=3000
